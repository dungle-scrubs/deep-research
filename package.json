{
  "name": "@dungle-scrubs/deep-research",
  "version": "0.1.0",
  "description": "dr - deterministic deep-research pipeline CLI (caller-supplied intelligence, CLI-held validation)",
  "license": "MIT",
  "author": "Kevin Frilot <kevinfrilot@icloud.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungle-scrubs/deep-research.git"
  },
  "homepage": "https://github.com/dungle-scrubs/deep-research#readme",
  "bugs": {
    "url": "https://github.com/dungle-scrubs/deep-research/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills"
  ],
  "bin": {
    "dr": "./dist/dr.mjs"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsdown && node scripts/embed.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "test": "vitest run",
    "pretest": "pnpm build",
    "smoke": "pnpm build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "marked": "18.0.14",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "lefthook": "^2.1.14",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
